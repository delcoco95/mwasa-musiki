# Seul le fichier de contenu est lisible ; aucun programme exécutable
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar .cgi .pl .py .sh
<FilesMatch ".*">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<Files "site.json">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Allow from all
  </IfModule>
</Files>
