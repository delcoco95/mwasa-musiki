# Aucun programme ne peut être exécuté ici (protection si un fichier malveillant y était déposé)
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .sh
<FilesMatch "\.(php\d?|phtml|phar|cgi|pl|py|sh|html?)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
